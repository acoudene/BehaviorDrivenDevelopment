<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- On isole cette solution des flux privés Azure DevOps (accès 403) :
       seuls nuget.org et le cache hors-ligne Visual Studio sont utilisés. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
